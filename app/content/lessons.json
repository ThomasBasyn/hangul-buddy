{
  "course": "Koreaans voor beginners",
  "lessons": [
    {
      "id": 1,
      "title": "Begroetingen",
      "note": "In het Koreaans hangt je taal af van met wie je praat. Vormen op -요 en -니다 zijn beleefd: gebruik die met onbekenden, in winkels en tegen ouderen. -니다 klinkt nog formeler dan -요.",
      "items": [
        {"id": "1-1", "ko": "안녕하세요", "rom": "annyeonghaseyo", "nl": "Hallo (beleefd)"},
        {"id": "1-2", "ko": "감사합니다", "rom": "gamsahamnida", "nl": "Dank u", "tip": "합니다 klinkt als 함니다: een ㅂ vóór een ㄴ wordt een m-klank."},
        {"id": "1-3", "ko": "네", "rom": "ne", "nl": "Ja"},
        {"id": "1-4", "ko": "아니요", "rom": "aniyo", "nl": "Nee"},
        {"id": "1-5", "ko": "죄송합니다", "rom": "joesonghamnida", "nl": "Het spijt me (formeel)"},
        {"id": "1-6", "ko": "괜찮아요", "rom": "gwaenchanayo", "nl": "Het is oké / geen probleem", "tip": "De ㅎ in 찮 is stil: je zegt 괜차나요."},
        {"id": "1-7", "ko": "반갑습니다", "rom": "bangapseumnida", "nl": "Aangenaam (kennis te maken)"},
        {"id": "1-8", "ko": "안녕히 가세요", "rom": "annyeonghi gaseyo", "nl": "Tot ziens (tegen wie vertrekt)"},
        {"id": "1-9", "ko": "안녕히 계세요", "rom": "annyeonghi gyeseyo", "nl": "Tot ziens (tegen wie blijft)"}
      ]
    },
