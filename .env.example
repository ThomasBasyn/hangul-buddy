# Copy to .env and fill in:  cp .env.example .env

# Optional: protects the API (web app asks for it once). Generate: openssl rand -hex 16
APP_TOKEN=

# Number of new words per day
NEW_PER_DAY=5

# Optional: Azure Speech for natural Korean TTS and real pronunciation scoring.
# Without it the app falls back to the browser's voice and speech recognition.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_TTS_VOICE=ko-KR-SunHiNeural

TZ_NAME=Europe/Brussels
