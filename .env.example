# Copy to .env and fill in:  cp .env.example .env

# Optional: protects the API (web app asks for it once). Generate: openssl rand -hex 16
APP_TOKEN=

# Number of new words per day
NEW_PER_DAY=5

# Name of the first user (the owner, who logs in with APP_TOKEN)
OWNER_NAME=
# Extra users: docker compose exec hangul-buddy python manage.py add-user <name>
# Users can store their own Azure key in the app. It is encrypted with KEY_SECRET
# (defaults to APP_TOKEN; if you change it, stored user keys stop working).
KEY_SECRET=

# Optional: Azure Speech for natural Korean TTS and real pronunciation scoring.
# Without it the app falls back to the browser's voice and speech recognition.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_TTS_VOICE=ko-KR-SunHiNeural
# The free Azure tier allows one speech call at a time. Raise this on a paid tier.
# AZURE_STT_CONCURRENCY=1

TZ_NAME=Europe/Brussels
